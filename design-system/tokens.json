{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "EasyAlgos Web Design System 2. Source of truth for colour and typography, mirroring the Figma library at figma.com/design/N9KYswH8G8z9T6wOoSMqLk. Primitives are raw values and should not be referenced by product code; the semantic groups are the public API.",

  "color": {
    "neutral": {
      "$description": "The system's only neutral ramp. Violet-tinted end to end, bottoming out at the wordmark ink. Replaces Tinted/*, Neutral/* and Ink/*.",
      "25":  { "$type": "color", "$value": "#F7F7FB" },
      "50":  { "$type": "color", "$value": "#F0F1F7" },
      "100": { "$type": "color", "$value": "#E4E6F0" },
      "200": { "$type": "color", "$value": "#C9CCDD" },
      "300": { "$type": "color", "$value": "#AEB2C9" },
      "400": { "$type": "color", "$value": "#9499B6" },
      "500": { "$type": "color", "$value": "#7A7FA3" },
      "600": { "$type": "color", "$value": "#62678F" },
      "700": { "$type": "color", "$value": "#51567A" },
      "800": { "$type": "color", "$value": "#433E68" },
      "900": { "$type": "color", "$value": "#2F2A4A" },
      "950": { "$type": "color", "$value": "#1C1833" },
      "975": { "$type": "color", "$value": "#0B1125" }
    },
    "gray": {
      "$description": "True-neutral greyscale, carrying no violet tint. A deliberate second ramp with its own territory: the dark bands and footer run on grey, and so do product screenshots, code surfaces, third-party embeds and monochrome media. Light page chrome, body text and borders stay on neutral/*. Never convert one ramp into the other to tidy up — the split is intentional.",
      "25":  { "$type": "color", "$value": "#FAFAFA" },
      "50":  { "$type": "color", "$value": "#F5F5F5" },
      "100": { "$type": "color", "$value": "#E5E5E5" },
      "200": { "$type": "color", "$value": "#D4D4D4" },
      "300": { "$type": "color", "$value": "#A3A3A3" },
      "400": { "$type": "color", "$value": "#737373" },
      "500": { "$type": "color", "$value": "#525252" },
      "600": { "$type": "color", "$value": "#404040" },
      "700": { "$type": "color", "$value": "#262626" },
      "800": { "$type": "color", "$value": "#171717" },
      "900": { "$type": "color", "$value": "#0A0A0A" },
      "950": { "$type": "color", "$value": "#050505" }
    },
    "blue": {
      "$description": "Action and accent. 600 is the default action fill; 700 the deeper blue the CTA gradient starts from.",
      "50":  { "$type": "color", "$value": "#EBF1FF" },
      "100": { "$type": "color", "$value": "#D2DFFE" },
      "200": { "$type": "color", "$value": "#A6BFFD" },
      "300": { "$type": "color", "$value": "#7EA2FC" },
      "400": { "$type": "color", "$value": "#5481F9" },
      "500": { "$type": "color", "$value": "#3D71F8" },
      "600": { "$type": "color", "$value": "#285FF7" },
      "700": { "$type": "color", "$value": "#074CFB" },
      "800": { "$type": "color", "$value": "#1E48B9" },
      "900": { "$type": "color", "$value": "#163486" }
    },
    "violet": {
      "$description": "Brand identity. Brand moments only - never a second accent alongside blue.",
      "50":  { "$type": "color", "$value": "#F2F0FF" },
      "100": { "$type": "color", "$value": "#E4E0FF" },
      "200": { "$type": "color", "$value": "#C9C2FF" },
      "300": { "$type": "color", "$value": "#AFA3FF" },
      "400": { "$type": "color", "$value": "#8B7EFF" },
      "500": { "$type": "color", "$value": "#7D73EA" },
      "600": { "$type": "color", "$value": "#7469D7" },
      "700": { "$type": "color", "$value": "#5A50C9" },
      "800": { "$type": "color", "$value": "#4134BC" },
      "900": { "$type": "color", "$value": "#2C2382" }
    },
    "brand": {
      "$description": "Gradient stops and the logo mark. Not ramp steps - they only ever appear inside the signature sweep.",
      "indigo":        { "$type": "color", "$value": "#5959FF" },
      "indigo-bright": { "$type": "color", "$value": "#7272FF" },
      "indigo-light":  { "$type": "color", "$value": "#A299FF" },
      "purple":        { "$type": "color", "$value": "#B36DFF" },
      "purple-bright": { "$type": "color", "$value": "#B571FF" },
      "blue-bright":   { "$type": "color", "$value": "#4379FF" }
    },
    "success": {
      "subtle": { "$type": "color", "$value": "#F0FDF4" },
      "base":   { "$type": "color", "$value": "#00DB63" },
      "strong": { "$type": "color", "$value": "#00BA38" },
      "text":   { "$type": "color", "$value": "#067A3C", "$description": "5.5:1 on white. The only green safe for text." },
      "deep":   { "$type": "color", "$value": "#06301C" }
    },
    "warning": {
      "subtle": { "$type": "color", "$value": "#FFFBEB" },
      "base":   { "$type": "color", "$value": "#FB951E" },
      "strong": { "$type": "color", "$value": "#EE7206" },
      "text":   { "$type": "color", "$value": "#B45309", "$description": "5.1:1 on white." },
      "deep":   { "$type": "color", "$value": "#3A2408" }
    },
    "danger": {
      "subtle": { "$type": "color", "$value": "#FEF2F2" },
      "base":   { "$type": "color", "$value": "#FF1519" },
      "strong": { "$type": "color", "$value": "#DC2626", "$description": "4.8:1 on white - doubles as the text red." },
      "deep":   { "$type": "color", "$value": "#3A0C0C" }
    },
    "data": {
      "$description": "Eight categorical series, ordered so neighbours stay separable. For a soft variant use the same colour at 20% alpha rather than a second ramp.",
      "01": { "$type": "color", "$value": "#5079E2" },
      "02": { "$type": "color", "$value": "#E5C31A" },
      "03": { "$type": "color", "$value": "#42DBE0" },
      "04": { "$type": "color", "$value": "#E160C3" },
      "05": { "$type": "color", "$value": "#3CE331" },
      "06": { "$type": "color", "$value": "#6B58E4" },
      "07": { "$type": "color", "$value": "#42E07A" },
      "08": { "$type": "color", "$value": "#C960E1" }
    },
    "external": {
      "$description": "Third-party marks, fixed by their owners. Never reuse as UI colour.",
      "trustpilot": { "$type": "color", "$value": "#00B67A" },
      "star-empty": { "$type": "color", "$value": "#D9D9D9" }
    },
    "shadow": {
      "$description": "Elevation is tinted, not black.",
      "ambient":      { "$type": "color", "$value": "#807B8F" },
      "ambient-deep": { "$type": "color", "$value": "#252033" },
      "card":         { "$type": "color", "$value": "#546BC5" },
      "action":       { "$type": "color", "$value": "#3F61EB" }
    },
    "base": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" }
    }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Poppins", "ui-sans-serif", "system-ui"], "$description": "Headings, labels, buttons, navigation." },
      "text":    { "$type": "fontFamily", "$value": ["Roboto", "ui-sans-serif", "system-ui"], "$description": "Running copy only." },
      "data":    { "$type": "fontFamily", "$value": ["Rubik", "Roboto", "sans-serif"], "$description": "Product-screenshot and dashboard artwork. Has no text style - artwork below 12px sits outside the system." }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "$description": "One ramp, thirteen steps. 12 is the floor for interface text.",
      "xs":   { "$type": "dimension", "$value": "0.75rem" },
      "sm":   { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "md":   { "$type": "dimension", "$value": "1.125rem" },
      "lg":   { "$type": "dimension", "$value": "1.25rem" },
      "xl":   { "$type": "dimension", "$value": "1.5rem" },
      "2xl":  { "$type": "dimension", "$value": "1.75rem" },
      "3xl":  { "$type": "dimension", "$value": "2rem" },
      "4xl":  { "$type": "dimension", "$value": "2.5rem" },
      "5xl":  { "$type": "dimension", "$value": "3rem" },
      "6xl":  { "$type": "dimension", "$value": "3.5rem" },
      "7xl":  { "$type": "dimension", "$value": "4rem" },
      "8xl":  { "$type": "dimension", "$value": "4.5rem" }
    },
    "leading": {
      "$description": "Ratios, so leading scales with the size it sits on. Figma stores line-height variables in pixels only, so these live in the text styles there.",
      "none":    { "$type": "number", "$value": 1 },
      "tight":   { "$type": "number", "$value": 1.15 },
      "snug":    { "$type": "number", "$value": 1.25 },
      "normal":  { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    },
    "tracking": {
      "$description": "Optical correction. Display type needs negative tracking; prose needs none.",
      "tighter": { "$type": "dimension", "$value": "-0.03em" },
      "tight":   { "$type": "dimension", "$value": "-0.02em" },
      "normal":  { "$type": "dimension", "$value": "0em" },
      "wide":    { "$type": "dimension", "$value": "0.01em" },
      "widest":  { "$type": "dimension", "$value": "0.08em" },
      "eyebrow": { "$type": "dimension", "$value": "0.25em", "$description": "The house eyebrow treatment on the marketing site. Only for 12px caps labels of a few words." }
    }
  },

  "space": {
    "0":   { "$type": "dimension", "$value": "0px" },
    "2":   { "$type": "dimension", "$value": "2px" },
    "4":   { "$type": "dimension", "$value": "4px" },
    "8":   { "$type": "dimension", "$value": "8px" },
    "12":  { "$type": "dimension", "$value": "12px" },
    "16":  { "$type": "dimension", "$value": "16px" },
    "20":  { "$type": "dimension", "$value": "20px" },
    "24":  { "$type": "dimension", "$value": "24px" },
    "32":  { "$type": "dimension", "$value": "32px" },
    "40":  { "$type": "dimension", "$value": "40px" },
    "48":  { "$type": "dimension", "$value": "48px" },
    "64":  { "$type": "dimension", "$value": "64px" },
    "80":  { "$type": "dimension", "$value": "80px" },
    "96":  { "$type": "dimension", "$value": "96px" },
    "120": { "$type": "dimension", "$value": "120px" }
  },

  "radius": {
    "0":    { "$type": "dimension", "$value": "0px" },
    "4":    { "$type": "dimension", "$value": "4px" },
    "6":    { "$type": "dimension", "$value": "6px" },
    "8":    { "$type": "dimension", "$value": "8px" },
    "12":   { "$type": "dimension", "$value": "12px" },
    "20":   { "$type": "dimension", "$value": "20px" },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "Fully rounded. The Figma variable stores 500 because Figma has no infinity value; both express the same intent, and 500px would stop being fully round above 1000px tall." }
  },

  "border": {
    "1": { "$type": "dimension", "$value": "1px" },
    "2": { "$type": "dimension", "$value": "2px" }
  },

  "size": {
    "icon-16":    { "$type": "dimension", "$value": "16px" },
    "icon-20":    { "$type": "dimension", "$value": "20px" },
    "icon-24":    { "$type": "dimension", "$value": "24px" },
    "control-36": { "$type": "dimension", "$value": "36px" },
    "control-48": { "$type": "dimension", "$value": "48px" },
    "control-56": { "$type": "dimension", "$value": "56px" }
  },

  "semantic": {
    "$description": "The public API for colour. 47 roles, each resolving in both modes. Name the job, never the colour.",
    "light": {
      "text": {
        "primary":    { "$type": "color", "$value": "{color.neutral.950}" },
        "secondary":  { "$type": "color", "$value": "{color.neutral.700}" },
        "tertiary":   { "$type": "color", "$value": "{color.neutral.500}" },
        "disabled":   { "$type": "color", "$value": "{color.neutral.300}" },
        "inverse":    { "$type": "color", "$value": "{color.base.white}" },
        "brand":      { "$type": "color", "$value": "{color.violet.800}" },
        "accent":     { "$type": "color", "$value": "{color.blue.700}" },
        "on-accent":  { "$type": "color", "$value": "{color.base.white}" }
      },
      "bg": {
        "canvas":         { "$type": "color", "$value": "{color.base.white}" },
        "surface":        { "$type": "color", "$value": "{color.neutral.25}" },
        "surface-alt":    { "$type": "color", "$value": "{color.neutral.50}" },
        "sunken":         { "$type": "color", "$value": "{color.neutral.100}" },
        "inverse":        { "$type": "color", "$value": "{color.neutral.975}" },
        "brand-subtle":   { "$type": "color", "$value": "{color.violet.50}" },
        "accent-subtle":  { "$type": "color", "$value": "{color.blue.50}" },
        "hover":          { "$type": "color", "$value": "{color.neutral.50}" },
        "active":         { "$type": "color", "$value": "{color.neutral.100}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{color.neutral.50}" },
        "default": { "$type": "color", "$value": "{color.neutral.100}" },
        "strong":  { "$type": "color", "$value": "{color.neutral.300}" },
        "focus":   { "$type": "color", "$value": "{color.blue.600}" },
        "inverse": { "$type": "color", "$value": "{color.neutral.800}" }
      },
      "action": {
        "primary":         { "$type": "color", "$value": "{color.blue.600}" },
        "primary-hover":   { "$type": "color", "$value": "{color.blue.700}" },
        "primary-active":  { "$type": "color", "$value": "{color.blue.800}" },
        "on-primary":      { "$type": "color", "$value": "{color.base.white}" },
        "secondary":       { "$type": "color", "$value": "{color.base.white}" },
        "secondary-hover": { "$type": "color", "$value": "{color.blue.50}" },
        "on-secondary":    { "$type": "color", "$value": "{color.blue.700}" },
        "ink":             { "$type": "color", "$value": "{color.neutral.900}" },
        "ink-hover":       { "$type": "color", "$value": "{color.neutral.800}" },
        "on-ink":          { "$type": "color", "$value": "{color.base.white}" },
        "disabled":        { "$type": "color", "$value": "{color.neutral.100}" },
        "on-disabled":     { "$type": "color", "$value": "{color.neutral.400}" }
      },
      "feedback": {
        "success":    { "$type": "color", "$value": "{color.success.base}" },
        "success-bg": { "$type": "color", "$value": "{color.success.subtle}" },
        "warning":    { "$type": "color", "$value": "{color.warning.strong}" },
        "warning-bg": { "$type": "color", "$value": "{color.warning.subtle}" },
        "danger":     { "$type": "color", "$value": "{color.danger.strong}" },
        "danger-bg":  { "$type": "color", "$value": "{color.danger.subtle}" },
        "info":       { "$type": "color", "$value": "{color.blue.700}" },
        "info-bg":    { "$type": "color", "$value": "{color.blue.50}" }
      },
      "metric": {
        "positive": { "$type": "color", "$value": "{color.success.text}" },
        "negative": { "$type": "color", "$value": "{color.danger.strong}" },
        "neutral":  { "$type": "color", "$value": "{color.neutral.500}" }
      },
      "brand": {
        "wordmark": { "$type": "color", "$value": "{color.neutral.975}" },
        "mark":     { "$type": "color", "$value": "{color.brand.indigo}" }
      }
    },
    "dark": {
      "text": {
        "primary":    { "$type": "color", "$value": "{color.neutral.25}" },
        "secondary":  { "$type": "color", "$value": "{color.neutral.300}" },
        "tertiary":   { "$type": "color", "$value": "{color.neutral.400}" },
        "disabled":   { "$type": "color", "$value": "{color.neutral.600}" },
        "inverse":    { "$type": "color", "$value": "{color.neutral.950}" },
        "brand":      { "$type": "color", "$value": "{color.violet.300}" },
        "accent":     { "$type": "color", "$value": "{color.blue.300}" },
        "on-accent":  { "$type": "color", "$value": "{color.base.white}" }
      },
      "bg": {
        "canvas":         { "$type": "color", "$value": "{color.neutral.975}" },
        "surface":        { "$type": "color", "$value": "{color.neutral.950}" },
        "surface-alt":    { "$type": "color", "$value": "{color.neutral.900}" },
        "sunken":         { "$type": "color", "$value": "{color.neutral.975}" },
        "inverse":        { "$type": "color", "$value": "{color.base.white}" },
        "brand-subtle":   { "$type": "color", "$value": "{color.violet.900}" },
        "accent-subtle":  { "$type": "color", "$value": "{color.blue.900}" },
        "hover":          { "$type": "color", "$value": "{color.neutral.900}" },
        "active":         { "$type": "color", "$value": "{color.neutral.800}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{color.neutral.900}" },
        "default": { "$type": "color", "$value": "{color.neutral.800}" },
        "strong":  { "$type": "color", "$value": "{color.neutral.600}" },
        "focus":   { "$type": "color", "$value": "{color.blue.400}" },
        "inverse": { "$type": "color", "$value": "{color.neutral.200}" }
      },
      "action": {
        "primary":         { "$type": "color", "$value": "{color.blue.500}" },
        "primary-hover":   { "$type": "color", "$value": "{color.blue.400}" },
        "primary-active":  { "$type": "color", "$value": "{color.blue.600}" },
        "on-primary":      { "$type": "color", "$value": "{color.base.white}" },
        "secondary":       { "$type": "color", "$value": "{color.neutral.900}" },
        "secondary-hover": { "$type": "color", "$value": "{color.neutral.800}" },
        "on-secondary":    { "$type": "color", "$value": "{color.blue.300}" },
        "ink":             { "$type": "color", "$value": "{color.base.white}" },
        "ink-hover":       { "$type": "color", "$value": "{color.neutral.25}" },
        "on-ink":          { "$type": "color", "$value": "{color.neutral.950}" },
        "disabled":        { "$type": "color", "$value": "{color.neutral.800}" },
        "on-disabled":     { "$type": "color", "$value": "{color.neutral.600}" }
      },
      "feedback": {
        "success":    { "$type": "color", "$value": "{color.success.base}" },
        "success-bg": { "$type": "color", "$value": "{color.success.deep}" },
        "warning":    { "$type": "color", "$value": "{color.warning.base}" },
        "warning-bg": { "$type": "color", "$value": "{color.warning.deep}" },
        "danger":     { "$type": "color", "$value": "{color.danger.base}" },
        "danger-bg":  { "$type": "color", "$value": "{color.danger.deep}" },
        "info":       { "$type": "color", "$value": "{color.blue.400}" },
        "info-bg":    { "$type": "color", "$value": "{color.blue.900}" }
      },
      "metric": {
        "positive": { "$type": "color", "$value": "{color.success.base}" },
        "negative": { "$type": "color", "$value": "{color.danger.base}" },
        "neutral":  { "$type": "color", "$value": "{color.neutral.400}" }
      },
      "brand": {
        "wordmark": { "$type": "color", "$value": "{color.base.white}" },
        "mark":     { "$type": "color", "$value": "{color.brand.indigo-bright}" }
      }
    }
  },

  "typography": {
    "$description": "The 17 text styles. Figma names are given as $extensions.figma so a design and a class can be matched by eye.",
    "display-xl":      { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.7xl}",  "lineHeight": "{font.leading.tight}",   "letterSpacing": "{font.tracking.tighter}" }, "$extensions": { "figma": "Display/XL", "responsive": { "desktop": "4rem", "tablet": "3.5rem", "mobile": "2rem" } } },
    "display-l":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.5xl}",  "lineHeight": "{font.leading.snug}",    "letterSpacing": "{font.tracking.tighter}" }, "$extensions": { "figma": "Display/L", "responsive": { "desktop": "3rem", "tablet": "2.5rem", "mobile": "1.75rem" } } },
    "display-m":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.4xl}",  "lineHeight": "{font.leading.snug}",    "letterSpacing": "{font.tracking.tight}" },   "$extensions": { "figma": "Display/M", "responsive": { "desktop": "2.5rem", "tablet": "2rem", "mobile": "1.5rem" } } },
    "display-numeral": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.8xl}",  "lineHeight": "{font.leading.none}",    "letterSpacing": "{font.tracking.tighter}" }, "$extensions": { "figma": "Display/Numeral", "responsive": { "desktop": "4.5rem", "tablet": "3.5rem", "mobile": "2.5rem" } } },
    "heading-xl":      { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.3xl}",  "lineHeight": "{font.leading.snug}",    "letterSpacing": "{font.tracking.tight}" },   "$extensions": { "figma": "Heading/XL", "responsive": { "desktop": "2rem", "tablet": "1.75rem", "mobile": "1.5rem" } } },
    "heading-l":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.2xl}",  "lineHeight": "{font.leading.snug}",    "letterSpacing": "{font.tracking.tight}" },   "$extensions": { "figma": "Heading/L", "responsive": { "desktop": "1.75rem", "tablet": "1.5rem", "mobile": "1.25rem" } } },
    "heading-m":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.xl}",   "lineHeight": "{font.leading.normal}",  "letterSpacing": "{font.tracking.tight}" },   "$extensions": { "figma": "Heading/M" } },
    "heading-s":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.lg}",   "lineHeight": "{font.leading.normal}",  "letterSpacing": "{font.tracking.tight}" },   "$extensions": { "figma": "Heading/S" } },
    "body-l":          { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.md}",   "lineHeight": "{font.leading.relaxed}", "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Body/L" } },
    "body-m":          { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.base}", "lineHeight": "{font.leading.relaxed}", "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Body/M" } },
    "body-s":          { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.sm}",   "lineHeight": "{font.leading.relaxed}", "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Body/S" } },
    "label-l":         { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.base}", "lineHeight": "{font.leading.normal}",  "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Label/L" } },
    "label-m":         { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.sm}",   "lineHeight": "{font.leading.normal}",  "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Label/M" } },
    "label-s":         { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.medium}",   "fontSize": "{font.size.xs}",   "lineHeight": "{font.leading.normal}",  "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Label/S" } },
    "button":          { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.base}", "lineHeight": "{font.leading.none}",    "letterSpacing": "{font.tracking.wide}" },    "$extensions": { "figma": "Button" } },
    "overline":        { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.xs}",   "lineHeight": "{font.leading.none}",    "letterSpacing": "{font.tracking.widest}" },  "$extensions": { "figma": "Overline", "textTransform": "uppercase" } },
    "overline-wide":   { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.xs}",   "lineHeight": "{font.leading.none}",    "letterSpacing": "{font.tracking.eyebrow}" }, "$extensions": { "figma": "Overline Wide", "textTransform": "uppercase" } },
    "caption":         { "$type": "typography", "$value": { "fontFamily": "{font.family.text}",    "fontWeight": "{font.weight.regular}",  "fontSize": "{font.size.xs}",   "lineHeight": "{font.leading.normal}",  "letterSpacing": "{font.tracking.normal}" },  "$extensions": { "figma": "Caption" } }
  },

  "gradient": {
    "brand":        { "$type": "gradient", "$value": "linear-gradient(96deg, #285FF7 0%, #5959FF 50%, #B36DFF 100%)", "$description": "Headline accent and primary CTA on light surfaces." },
    "brand-bright": { "$type": "gradient", "$value": "linear-gradient(96deg, #4379FF 0%, #7272FF 50%, #B571FF 100%)", "$description": "The same sweep, lifted so it still reads on a dark band." },
    "mark":         { "$type": "gradient", "$value": "linear-gradient(180deg, #A299FF 0%, #7272FF 50%, #5959FF 100%)", "$description": "The logo mark." },
    "tile":         { "$type": "gradient", "$value": "linear-gradient(180deg, #EBF1FF 0%, #D2DFFE 100%)", "$description": "Pale surface wash behind feature tiles." }
  },

  "elevation": {
    "card":    { "$type": "shadow", "$value": "0 0 250px 0 rgba(128,123,143,0.12), 0 0 96px 0 rgba(37,32,51,0.04), 0 0 48px 0 rgba(37,32,51,0.02), -6px 0 12px 0 rgba(84,107,197,0.04)", "$description": "Resting card. Ambient with no offset, so it reads as suspended in the page." },
    "raised":  { "$type": "shadow", "$value": "0 0 250px 0 rgba(128,123,143,0.16), 0 24px 48px -24px rgba(37,32,51,0.18), -6px 0 12px 0 rgba(84,107,197,0.05)", "$description": "Card on hover." },
    "action":  { "$type": "shadow", "$value": "0 12px 30px -12px rgba(63,97,235,0.2), 0 1px 2px 0 rgba(11,17,37,0.16)", "$description": "Primary CTA - a blue bloom over a contact shadow." },
    "overlay": { "$type": "shadow", "$value": "0 20px 48px 12px rgba(37,32,51,0.14), 0 6px 10px 2px rgba(37,32,51,0.06)", "$description": "Menus, dropdowns, popovers." }
  }
}
